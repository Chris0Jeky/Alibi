{
  "name": "alibi-puzzle-club",
  "version": "0.9.0",
  "private": true,
  "description": "A mobile-first puzzle PWA with thirteen engines, illustrated mystery casebooks and an original puzzle workshop.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.cjs",
    "start": "node tools/serve.cjs",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs && node tests/quiet-wing/engines.cjs && node tests/quiet-wing/contracts.cjs",
    "format": "prettier --write \"src/**/*.{js,mjs,css,html}\" \"tools/*.cjs\" \"tests/*.cjs\" \"optional-online/*.mjs\" \"tests/*.mjs\" package.json",
    "format:check": "prettier --check \"src/**/*.{js,mjs,css,html}\" \"tools/*.cjs\" \"tests/*.cjs\" \"optional-online/*.mjs\" \"tests/*.mjs\" package.json",
    "verify": "npm run format:check && npm run build && npm test",
    "generate": "node tools/generate-content.cjs",
    "bundle": "node tools/package.cjs",
    "assets:visuals": "node tools/assets/visuals.cjs && node tools/assets/catalogue.cjs",
    "assets:catalogue": "node tools/assets/catalogue.cjs",
    "assets:check": "node --test tests/asset-*.test.cjs",
    "assets:media": "node tools/assets/decode-media.cjs",
    "assets:gallery": "node tools/serve-assets.cjs",
    "cloudflare:preview": "wrangler dev --config wrangler.jsonc",
    "cloudflare:check": "wrangler deploy --dry-run --config wrangler.jsonc",
    "cloudflare:deploy": "wrangler deploy --config wrangler.jsonc"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "prettier": "3.9.6",
    "sharp": "0.35.4",
    "three": "0.185.1",
    "wrangler": "4.129.1"
  },
  "overrides": {
    "miniflare@5.20260907.0-alpha": {
      "sharp": "0.35.4"
    }
  }
}
